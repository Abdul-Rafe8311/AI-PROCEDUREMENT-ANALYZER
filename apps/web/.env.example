# Existing
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (read only in src/lib/server/config.ts)
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated, lower-case emails; also the admin notification recipients
ADMIN_EMAILS=
# Comma-separated Supabase user ids; an admin needs BOTH email and id listed
ADMIN_USER_IDS=
SUPPORT_EMAIL=
# JSON, never NEXT_PUBLIC_*
BANK_DETAILS=
# JSON, e.g. {"pro":49,"max":99}
PLAN_PRICES_USD=
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Bearer secret for /api/cron/daily
CRON_SECRET=

# Local dev only: set to true to let /api guards return a synthetic demo user when the two
# Supabase vars above are both empty. Never set in production.
ALLOW_DEMO=
